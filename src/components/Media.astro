---
import { fetchPhotos, fetchVideos } from '../lib/wordpress';
import Section from './Section.astro';

const [{ featured, videos }, photos] = await Promise.all([fetchVideos(), fetchPhotos()]);

// A lone photo gets the featured-video width; more than one becomes a grid.
// `sizes` mirrors those layouts so the browser picks the right WP size.
const single = photos.length === 1;
const photoSizes = single ? '(min-width: 56rem) 56rem, 100vw' : '(min-width: 48rem) 50vw, 100vw';
---

<Section id="media" headline="Watch & Listen" color="papaya">
    <!-- Featured Video -->
    <div class="mx-auto mb-12 max-w-4xl">
        <div class="aspect-video overflow-hidden">
            <iframe
                src={`https://www.youtube.com/embed/${featured.youtubeId}`}
                title={featured.title}
                class="h-full w-full"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen></iframe>
        </div>
        <p class="mt-4 font-heading text-lg italic text-center">
            {featured.title}
        </p>
        {featured.description && <p class="text-center text-black">{featured.description}</p>}
    </div>

    <!-- More Videos -->
    {
        videos.length > 0 && (
            <>
                <h3 class="mb-6 text-center font-heading text-2xl italic">More Videos</h3>
                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {videos.map((video) => (
                        <article class="overflow-hidden">
                            <div class="aspect-video">
                                <iframe
                                    src={`https://www.youtube.com/embed/${video.youtubeId}`}
                                    title={video.title}
                                    class="h-full w-full"
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen
                                />
                            </div>
                            <div class="p-4">
                                <h4 class="font-heading text-lg italic text-center">
                                    {video.title}
                                </h4>
                                {video.description && (
                                    <p class="text-sm text-center text-black">
                                        {video.description}
                                    </p>
                                )}
                            </div>
                        </article>
                    ))}
                </div>
            </>
        )
    }

    <!-- Photos -->
    {
        photos.length > 0 && (
            <>
                <h3 class="mt-12 mb-6 text-center font-heading text-2xl italic">Photos</h3>
                <div class={single ? 'mx-auto max-w-4xl' : 'grid gap-6 md:grid-cols-2'}>
                    {photos.map((photo) => (
                        <figure>
                            <img
                                src={photo.src}
                                srcset={photo.srcset}
                                sizes={photoSizes}
                                width={photo.width}
                                height={photo.height}
                                alt={photo.alt}
                                loading="lazy"
                                decoding="async"
                                class="h-auto w-full"
                            />
                            {photo.caption && (
                                <figcaption
                                    class="mt-4 text-center text-sm text-black"
                                    set:html={photo.caption}
                                />
                            )}
                        </figure>
                    ))}
                </div>
            </>
        )
    }
</Section>
