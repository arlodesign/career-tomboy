---
import Gig from './Gig.astro';
import { getUpcomingGigs } from '../lib/gigs';
import Section from './Section.astro';

const upcomingGigs = await getUpcomingGigs();
// webcal:// makes calendar apps subscribe to the feed (and re-poll it) instead of
// downloading a one-off copy. It must be an absolute URL, so build it from the site host.
const webcalUrl = `webcal://${Astro.site!.host}/calendar.ics`;
// Google Calendar's "From URL" box rejects webcal://, so it gets the https form.
const feedUrl = new URL('/calendar.ics', Astro.site).href;
---

<Section id="gigs" headline="See us live!" color="strawberry">
    <div class="mx-auto max-w-3xl">
        <div
            id="gigs-list"
            role="feed"
            aria-label="Upcoming shows"
            class="mt-4 flex flex-col gap-4"
        >
            {upcomingGigs.map((gig) => <Gig gig={gig} />)}
            <p
                id="gigs-empty"
                class="py-8 text-center text-lg text-slate-700"
                hidden={upcomingGigs.length > 0}
            >
                No upcoming shows scheduled. Check back soon!
            </p>
        </div>
        <div class="mt-8 flex flex-col items-center gap-2 text-center text-sm">
            <button
                type="button"
                id="sub-open"
                class="inline-flex cursor-pointer items-center gap-1.5 border-2 border-black bg-black px-3 py-1 text-sm font-medium text-white transition-colors hover:bg-white hover:text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 16 16"
                    height="16"
                    width="16"
                >
                    <g>
                        <path
                            fill="currentColor"
                            fill-rule="evenodd"
                            d="M10.666666666666666 1.5H4.333333333333333V0H2.6666666666666665v1.5H0v13.666666666666666h7.333333333333333v-1.6666666666666665H1.6666666666666665V5.666666666666666H13.333333333333332v2.1073999999999997c0.6083999999999999 0.13279999999999997 1.1724666666666665 0.3843333333333333 1.6666666666666665 0.7290666666666665V1.5h-2.6666666666666665V0H10.666666666666666v1.5Zm-0.7135333333333334 8.5182c0.6377999999999999 -0.6377333333333333 1.5028 -0.9960666666666667 2.404733333333333 -0.9960666666666667s1.7669333333333332 0.3583333333333333 2.404733333333333 0.9960666666666667c0.06646666666666666 0.06646666666666666 0.12993333333333332 0.13546666666666665 0.19026666666666664 0.20666666666666667L15.666666666666666 9.511066666666666l0.3333333333333333 0.3333333333333333v2.6666666666666665h-2.6666666666666665l-0.3333333333333333 -0.3333333333333333 0.7664 -0.7664c-0.05453333333333333 -0.07586666666666667 -0.1154 -0.14766666666666667 -0.18233333333333335 -0.2146 -0.3252 -0.3252 -0.7662666666666667 -0.5079333333333333 -1.2262 -0.5079333333333333s-0.9009999999999999 0.18273333333333333 -1.2262 0.5079333333333333c-0.17119999999999996 0.1711333333333333 -0.3028666666666666 0.37439999999999996 -0.38926666666666665 0.5955999999999999l-1.5525333333333333 -0.6060666666666666c0.16933333333333334 -0.4337333333333333 0.4276 -0.8323999999999999 0.7632666666666666 -1.1680666666666666ZM11.333333333333332 12.511066666666666h-2.6666666666666665v2.6666666666666665l0.3333333333333333 0.3333333333333333 0.7961999999999999 -0.7961999999999999c0.08006666666666666 0.10066666666666665 0.16606666666666664 0.1972 0.25793333333333335 0.28906666666666664 0.6377333333333333 0.6377999999999999 1.5028 0.9960666666666667 2.404733333333333 0.9960666666666667s1.7669333333333332 -0.3582666666666666 2.404733333333333 -0.9960666666666667c0.3356666666666666 -0.3356666666666666 0.5939333333333333 -0.7343333333333333 0.7632666666666666 -1.1680666666666666l-1.5525333333333333 -0.6060666666666666c-0.08639999999999999 0.22119999999999998 -0.21806666666666666 0.42446666666666666 -0.38926666666666665 0.5955999999999999 -0.3252 0.3252 -0.7662666666666667 0.5079333333333333 -1.2262 0.5079333333333333s-0.9009999999999999 -0.18273333333333333 -1.2262666666666666 -0.5079333333333333c-0.09273333333333333 -0.0928 -0.17393333333333333 -0.19499999999999998 -0.24259999999999998 -0.30433333333333334l0.6766666666666665 -0.6766666666666665 -0.3333333333333333 -0.3333333333333333Z"
                            clip-rule="evenodd"
                            stroke-width="0.6667"></path>
                    </g>
                </svg>
                Subscribe to our calendar
            </button>
        </div>
        <dialog
            id="sub-dialog"
            aria-labelledby="sub-title"
            class="m-auto w-[min(92vw,30rem)] border-2 border-black bg-ct-white p-6 text-left text-ct-black backdrop:bg-black/60"
        >
            <h3 id="sub-title" class="font-heading text-xl italic">Subscribe to our calendar</h3>
            <p class="mt-1 text-sm">
                New shows show up in your calendar automatically. Pick your app:
            </p>

            <section class="mt-4" aria-labelledby="sub-apple">
                <h4 id="sub-apple" class="text-sm font-bold">Apple Calendar or Outlook</h4>
                <p class="mt-1 text-sm">This opens your calendar app and asks to subscribe.</p>
                <a
                    href={webcalUrl}
                    class="mt-2 inline-block border-2 border-black bg-black px-3 py-1 text-sm font-medium text-white hover:bg-transparent hover:text-black"
                >
                    Subscribe
                </a>
            </section>

            <section class="mt-5 border-t-2 border-black pt-4" aria-labelledby="sub-google">
                <h4 id="sub-google" class="text-sm font-bold">Google Calendar</h4>
                <p class="mt-1 text-sm">Google can't subscribe from a link, so add it by hand:</p>
                <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm">
                    <li>Open Google Calendar on a computer. The phone app can't add by link.</li>
                    <li>
                        In the left sidebar, click <strong>+</strong> next to <strong
                            >Other calendars</strong
                        >, then choose <strong>From URL</strong>.
                    </li>
                    <li>Paste the link below and click <strong>Add calendar</strong>.</li>
                </ol>
                <label class="mt-3 block text-sm font-bold" for="sub-url">Calendar link</label>
                <div class="mt-1 flex gap-2">
                    <input
                        id="sub-url"
                        type="text"
                        readonly
                        value={feedUrl}
                        class="min-w-0 flex-1 border-2 border-black bg-white px-2 py-1 text-sm"
                    />
                    <button
                        type="button"
                        id="sub-copy"
                        class="cursor-pointer border-2 border-black px-3 py-1 text-sm font-medium hover:bg-black hover:text-white"
                    >
                        Copy
                    </button>
                </div>
                <p
                    id="sub-status"
                    class="mt-1 min-h-5 text-sm font-bold"
                    role="status"
                    aria-live="polite"
                >
                </p>
                <p class="text-xs">
                    Google checks subscribed calendars only every so often, so new shows can take up
                    to a day to appear.
                </p>
            </section>

            <div class="mt-5 flex justify-end">
                <button
                    type="button"
                    id="sub-close"
                    class="cursor-pointer border-2 border-black px-3 py-1 text-sm font-medium hover:bg-black hover:text-white"
                >
                    Close
                </button>
            </div>
        </dialog>
    </div>
    <script is:inline>
        // The gig list is built at deploy time, so gigs that have passed since the last
        // deploy are hidden here. Dates are Chicago-local, so compare against today there.
        (function () {
            const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago' }).format(
                new Date(),
            );
            const gigs = document.querySelectorAll('#gigs-list article[data-gig-id]');
            let remaining = 0;
            gigs.forEach(function (gig) {
                const time = gig.querySelector('time');
                const date = time && time.getAttribute('datetime');
                if (date && date.slice(0, 10) < today) {
                    gig.hidden = true;
                } else {
                    remaining++;
                }
            });
            if (remaining === 0) document.getElementById('gigs-empty').hidden = false;
        })();

        // Subscribe dialog: Apple/Outlook use the webcal:// link; Google needs the https feed URL
        // pasted by hand, so offer a copy button.
        (function () {
            const dialog = document.getElementById('sub-dialog');
            const input = document.getElementById('sub-url');
            const status = document.getElementById('sub-status');

            function copy() {
                const done = function (ok) {
                    status.textContent = ok
                        ? 'Link copied to your clipboard!'
                        : "Couldn't copy automatically. Select the link and copy it.";
                    if (!ok) input.select();
                };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(input.value).then(
                        function () {
                            done(true);
                        },
                        function () {
                            done(false);
                        },
                    );
                } else {
                    done(false);
                }
            }

            document.getElementById('sub-open').addEventListener('click', function () {
                status.textContent = '';
                dialog.showModal();
            });
            document.getElementById('sub-copy').addEventListener('click', copy);
            document.getElementById('sub-close').addEventListener('click', function () {
                dialog.close();
            });
            // Clicking the backdrop (the dialog element itself, outside its content) closes it.
            dialog.addEventListener('click', function (e) {
                if (e.target === dialog) dialog.close();
            });
        })();
    </script>
</Section>
