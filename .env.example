# WordPress REST API base URL — required for pnpm build and pnpm dev
WP_API_BASE=

# WordPress theme deploy via rsync over SSH (after a successful push to main)
# Leave blank to skip theme deployment on push.
# Set WP_SSH_HOST to a Host alias from ~/.ssh/config so the real hostname
# lives only there; WP_SSH_USER can then stay blank if the alias sets User.
WP_SSH_HOST=
WP_SSH_USER=
WP_SSH_PATH=
WP_SSH_PORT=22
WP_SSH_KEY=/absolute/path/to/ssh/private-key
